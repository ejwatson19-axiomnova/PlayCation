# Copy to .env to point the app at Playcation's backend.
# Leave empty to use the built-in sample listings.
# EXPO_PUBLIC_* values ship inside the app and are visible to anyone: never put partner keys here.
EXPO_PUBLIC_API_URL=

# EazyTab ordering link (see docs/EAZYTAB.md). {venueId} is replaced per venue.
# Empty = EazyTab's demo. For production, e.g. https://eazytab.app/{venueId}
EXPO_PUBLIC_EAZYTAB_WEB_URL=

# EV charging stations (Open Charge Map, free key at openchargemap.org). Used only when
# EXPO_PUBLIC_API_URL is empty; otherwise the backend supplies chargers. No keys = built-in list of
# real stations near the demo venue (src/data/chargers-demo-venue.json).
EXPO_PUBLIC_OPENCHARGEMAP_KEY=
# NREL / U.S. DOE station data (free key at developer.nrel.gov). Can be set with the one above; results are merged.
EXPO_PUBLIC_NREL_KEY=

# Google Maps keys for store builds (read by app.config.js). Not needed for Expo Go.
# Android uses Google Maps and needs this key; iPhone uses Apple Maps unless an iOS key is set.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# ---- Backend only (server .env, never in the app) ----
# NREL_API_KEY=            (U.S. Alternative Fuel Stations data for chargers)
# OPENCHARGEMAP_API_KEY=
# EXPEDIA_RAPID_API_KEY=
# EXPEDIA_RAPID_SHARED_SECRET=
# BOOKING_COM_AFFILIATE_ID=
# BOOKING_COM_API_KEY=
# RENTALS_UNITED_USERNAME=
# RENTALS_UNITED_PASSWORD=
# NEXTPAX_API_KEY=
# BOOKINGPAL_API_KEY=
# GUESTY_CLIENT_ID=
# GUESTY_CLIENT_SECRET=
# HOSTAWAY_ACCOUNT_ID=
# HOSTAWAY_API_KEY=
# OWNERREZ_CLIENT_ID=
# OWNERREZ_CLIENT_SECRET=
